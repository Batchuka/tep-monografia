@inbook{Mahnke2009,
  author    = {Mahnke, Wolfgang
               and Leitner, Stefan-Helmut},
  title     = {Services},
  booktitle = {OPC Unified Architecture},
  year      = {2009},
  publisher = {Springer Berlin Heidelberg},
  address   = {Berlin, Heidelberg},
  pages     = {125--190},
  abstract  = {The OPC UA Services are defining the data communication on application level. Services are methods used by an OPC UA client to access the data of the Information Model provided by an OPC UA server. Similar to Classic OPC, where the OPC specifications just defined Application Programming Interface (APIs) bet?ween applications, the Services define the communication interface between UA applications. The definition of the Services is independent of the transport protocol and the programming environment that is used to develop an OPC UA application. This is the fundamental difference to Classic OPC where the definition of the APIs was bound to a specific transport mechanism -- Microsoft Component Object Model (COM).},
  isbn      = {978-3-540-68899-0},
  doi       = {10.1007/978-3-540-68899-0_5},
  url       = {https://doi.org/10.1007/978-3-540-68899-0_5}
}

