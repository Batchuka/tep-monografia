{
	"nodes":[
		{"id":"center","type":"text","text":"# MONOGRAFIA\n\n**Kubernetes para Aplicações IEC 61499**\n\nEstudo de caso: TEP (Tennessee Eastman Process)","x":-200,"y":-100,"width":400,"height":200,"color":"4"},
		{"id":"cap1","type":"text","text":"## Cap 1 — Introdução\n*(já escrito — revisar)*","x":-750,"y":-380,"width":280,"height":70,"color":"1"},
		{"id":"cap1_a","type":"text","text":"Indústria 4.0 / IIoT\n(contexto e motivação)","x":-1120,"y":-500,"width":260,"height":60},
		{"id":"cap1_b","type":"text","text":"Problema: orquestração de\naplicações distribuídas IEC 61499","x":-1120,"y":-420,"width":260,"height":60},
		{"id":"cap1_c","type":"text","text":"Proposta: Kubernetes + Operator\ncomo orquestrador industrial","x":-1120,"y":-340,"width":260,"height":60},
		{"id":"cap1_d","type":"text","text":"Objetivos específicos\n(configurar, modelar, medir)","x":-1120,"y":-260,"width":260,"height":60},
		{"id":"cap2","type":"text","text":"## Cap 2 — Referencial Teórico\n*(reescrever completamente)*","x":-750,"y":80,"width":280,"height":70,"color":"2"},
		{"id":"cap2_tep","type":"text","text":"Tennessee Eastman Process (TEP)\n(benchmark industrial, 41 XMEAS, 12 XMV)","x":-1120,"y":-40,"width":280,"height":60},
		{"id":"cap2_iec","type":"text","text":"IEC 61499\n(blocos funcionais distribuídos, eventos)","x":-1120,"y":40,"width":280,"height":60},
		{"id":"cap2_k8s","type":"text","text":"Kubernetes & Operators\n(Kubebuilder, CRDs, reconciliação)","x":-1120,"y":120,"width":280,"height":60},
		{"id":"cap2_grpc","type":"text","text":"gRPC\n(comunicação planta ↔ operador ↔ IHM)","x":-1120,"y":200,"width":280,"height":60},
		{"id":"cap2_rk4","type":"text","text":"Simulação Numérica (RK4)\n(integração da planta TEP, dt=0,001h)","x":-1120,"y":280,"width":280,"height":60},
		{"id":"cap2_twin","type":"text","text":"Digital Twin\n(gêmeo digital industrial)","x":-1120,"y":360,"width":280,"height":60},
		{"id":"cap3","type":"text","text":"## Cap 3 — Desenvolvimento\n*(reescrever completamente)*","x":500,"y":-380,"width":280,"height":70,"color":"3"},
		{"id":"cap3_plant","type":"text","text":"tep-plant (Rust)\nSimulação gRPC, RK4, te-core\nControllerBank (3 controladores P)","x":840,"y":-520,"width":280,"height":80},
		{"id":"cap3_operator","type":"text","text":"tep-operator (Go / Kubebuilder)\nCRD PLCMachine\nReconciliação via UpdateController","x":840,"y":-420,"width":280,"height":80},
		{"id":"cap3_ihm","type":"text","text":"tep-ihm (FastAPI + WebSocket)\nDashboard ECharts, ISA-101\nStreamMetrics em tempo real","x":840,"y":-320,"width":280,"height":80},
		{"id":"cap3_supervisor","type":"text","text":"tep-supervisor\nDocker Compose (dev)\nKind (cluster Kubernetes local)","x":840,"y":-220,"width":280,"height":80},
		{"id":"cap3_arch","type":"text","text":"Arquitetura geral\nBrowser→IHM→Plant→Operator\n(diagrama de fluxo)","x":840,"y":-120,"width":280,"height":80},
		{"id":"cap4","type":"text","text":"## Cap 4 — Resultados\n*(escrever a partir de experiments.md)*","x":500,"y":120,"width":280,"height":70,"color":"5"},
